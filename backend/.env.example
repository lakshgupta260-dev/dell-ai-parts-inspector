# Dell AI Parts Inspector — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── OpenAI (for LangGraph + GPT-4.1 AI reasoning) ────────────────────────────
OPENAI_API_KEY=

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Vapi (voice call notifications) ──────────────────────────────────────────
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# ── Resend (email, future use) ────────────────────────────────────────────────
RESEND_API_KEY=

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-256-bit-secret-in-production
JWT_EXPIRE_MINUTES=480

# ── Database (leave blank for SQLite default) ─────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/dell_inspector
DATABASE_URL=
